        </mxCell>
        <mxCell id="title_b4" value="&lt;b&gt;BOUNDARY 4: Cross-Dataset Validation &amp;amp; Household BESS Asset Management&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="50" y="538" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Node 13 -->
        <mxCell id="cell_n13" value="&lt;b&gt;13. Multi-Tier Validation Protocol&lt;/b&gt;&lt;br&gt;• Tier 1: In-domain testing (B0018)&lt;br&gt;• Tier 2: Zero-shot cross-dataset&lt;br&gt;• Tier 3: Few-shot fine-tuning (first 10-20 cycles)&lt;br&gt;&lt;i&gt;[Strict Out-of-Sample Verification]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f1c40f;strokeWidth=1.4;fontSize=9.5;fontColor=#7d6608;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="562" width="310" height="75" as="geometry" />
        </mxCell>

        <!-- Node 14 -->
        <mxCell id="cell_n14" value="&lt;b&gt;14. Performance Benchmarking&lt;/b&gt;&lt;br&gt;• Standard Metrics: MAE, RMSE [Cycles], R² Score&lt;br&gt;• Industrial Metric: NASA Asymmetric PHM Score&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Penalizes overestimation to guarantee BESS safety&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="562" width="350" height="75" as="geometry" />
        </mxCell>

        <!-- Node 15 -->
        <mxCell id="cell_n15" value="&lt;i&gt;&lt;b&gt;15. BESS Asset Management Outputs&lt;/b&gt;&lt;br&gt;• 80% EOL early warning threshold triggers&lt;br&gt;• Dynamic module rebalancing &amp;amp; replacement plan&lt;br&gt;• Actionable predictive maintenance schedules&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;strokeWidth=1.4;fontSize=9.5;fontColor=#145a32;align=left;spacingLeft=6;" vertex="1" parent="1">
