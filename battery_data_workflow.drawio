        <!-- ==================== BOUNDARY 1 ==================== -->
        <mxCell id="box_b1" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=none;strokeColor=#7f8c8d;strokeWidth=1.5;" vertex="1" parent="1">
