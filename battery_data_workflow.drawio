        </mxCell>
        <mxCell id="title_b1" value="&lt;b&gt;BOUNDARY 1: Heterogeneous Battery Data Sources &amp;amp; Repositories&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="50" y="33" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- Node 1 -->
        <mxCell id="cell_n1" value="&lt;b&gt;1. Target Selection&lt;/b&gt;&lt;br&gt;• Target: Household BESS&lt;br&gt;• Key Chemistries:&lt;br&gt;&amp;nbsp;&amp;nbsp;LFP (Safety / Long Life)&lt;br&gt;&amp;nbsp;&amp;nbsp;NMC (High Energy Density)&lt;br&gt;&lt;i&gt;[Researcher Design Decision]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f1c40f;strokeWidth=1.4;fontSize=9.5;fontColor=#7d6608;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="58" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- Node 2 -->
        <mxCell id="cell_n2" value="&amp;lt;&amp;lt;datastore&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;NASA PCoE Benchmark&lt;/b&gt;&lt;br&gt;• Chemistry: LCO 18650&lt;br&gt;• Cells: B0005, 06, 07, 18&lt;br&gt;• Rated: 2.0 Ah Nominal&lt;br&gt;• Multi-Temp: 24°C, 4°C, 43°C&lt;br&gt;&lt;i&gt;[Raw Cycling &amp;amp; EIS Sweeps]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf5fb;strokeColor=#3498db;strokeWidth=1.4;fontSize=9.5;fontColor=#1b4f72;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="58" width="190" height="95" as="geometry" />
        </mxCell>

        <!-- Node 3 -->
        <mxCell id="cell_n3" value="&amp;lt;&amp;lt;datastore&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;CALCE / Stanford Benchmark&lt;/b&gt;&lt;br&gt;• Chemistries: NMC / LFP&lt;br&gt;• Cells: CS2, CX2, A123&lt;br&gt;• Rated: 1.1 Ah - 1.35 Ah&lt;br&gt;• CC-CV &amp;amp; Fast Aging Profiles&lt;br&gt;&lt;i&gt;[Cross-Validation Baseline]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf5fb;strokeColor=#3498db;strokeWidth=1.4;fontSize=9.5;fontColor=#1b4f72;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="475" y="58" width="180" height="95" as="geometry" />
        </mxCell>

        <mxCell id="edge_1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2c3e50;strokeWidth=1.3;endArrow=classic;endFill=1;" edge="1" parent="1" source="cell_n1" target="cell_n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_1_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2c3e50;strokeWidth=1.3;endArrow=classic;endFill=1;" edge="1" parent="1" source="cell_n1" target="cell_n3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="245" y="130" />
              <mxPoint x="465" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== BOUNDARY 2 ==================== -->
        <mxCell id="box_b2" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=none;strokeColor=#7f8c8d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="1110" height="145" as="geometry" />
        </mxCell>
        <mxCell id="title_b2" value="&lt;b&gt;BOUNDARY 2: Signal Preprocessing, Correlation Analysis &amp;amp; Factor Ranking (Phase 1)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="50" y="193" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Node 4 -->
        <mxCell id="cell_n4" value="&lt;b&gt;4. Ingestion &amp;amp; Slicing&lt;/b&gt;&lt;br&gt;• Automated cycle segmentation&lt;br&gt;• Outlier &amp;amp; noise filtering&lt;br&gt;• Numerical integration:&lt;br&gt;&amp;nbsp;&amp;nbsp;Q_k = ∫ I(t) dt&lt;br&gt;&lt;i&gt;[Automated Python Script]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="222" width="180" height="98" as="geometry" />
        </mxCell>

        <!-- Node 5 -->
        <mxCell id="cell_n5" value="&lt;b&gt;5. Extract Candidate HIs&lt;/b&gt;&lt;br&gt;• Discharge Duration (Δt)&lt;br&gt;• Voltage drop time (3.8V→3.4V)&lt;br&gt;• Peak temp rise (ΔT_max)&lt;br&gt;• Ohmic (Re) &amp;amp; Charge (Rct)&lt;br&gt;&lt;i&gt;[Physical Feature Vectors]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="222" width="190" height="98" as="geometry" />
        </mxCell>

        <!-- Node 6 -->
        <mxCell id="cell_n6" value="&lt;b&gt;6. Correlation Metrics&lt;/b&gt;&lt;br&gt;• Pearson (r): Linear tracking&lt;br&gt;• Spearman (ρ): Monotonicity&lt;br&gt;• Grey Relational Analysis (GRA):&lt;br&gt;&amp;nbsp;&amp;nbsp;Curve trajectory similarity&lt;br&gt;&lt;i&gt;[Statistical Evaluation]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="495" y="222" width="195" height="98" as="geometry" />
        </mxCell>

        <!-- Node 7 -->
        <mxCell id="cell_n7" value="&lt;b&gt;7. Cross-Dataset Ranking &amp;amp; Mapping&lt;/b&gt;&lt;br&gt;• Compare factor ranks across&lt;br&gt;&amp;nbsp;&amp;nbsp;LFP vs. NMC vs. LCO&lt;br&gt;• &lt;b&gt;Create mapping for each factor to a universal space&lt;/b&gt;&lt;br&gt;• Filter threshold: |ρ| &amp;gt; 0.85&lt;br&gt;&lt;i&gt;[Researcher Mapping &amp;amp; Screening Decision]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f1c40f;strokeWidth=1.4;fontSize=9.5;fontColor=#7d6608;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="725" y="222" width="205" height="98" as="geometry" />
        </mxCell>

        <!-- Node 8 -->
        <mxCell id="cell_n8" value="&amp;lt;&amp;lt;datastore&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Universal Health Indicators&lt;/b&gt;&lt;br&gt;Mapped &amp;amp; ranked feature space&lt;br&gt;reconciling LFP/NMC/LCO differences&lt;br&gt;• Universal inputs for ML&lt;br&gt;&lt;i&gt;[Universal Tabular Feature Store]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf5fb;strokeColor=#3498db;strokeWidth=1.4;fontSize=9.5;fontColor=#1b4f72;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="955" y="222" width="180" height="98" as="geometry" />
        </mxCell>

