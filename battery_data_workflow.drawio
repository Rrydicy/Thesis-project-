            <Array as="points">
              <mxPoint x="355" y="175" />
              <mxPoint x="145" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== BOUNDARY 3 ==================== -->
        <mxCell id="box_b3" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=none;strokeColor=#7f8c8d;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1110" height="155" as="geometry" />
        </mxCell>
        <mxCell id="title_b3" value="&lt;b&gt;BOUNDARY 3: Dimensionless Integration &amp;amp; Dual-Track Predictive Modeling (Phase 2)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="50" y="363" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Node 9 -->
        <mxCell id="cell_n9" value="&lt;b&gt;9. Dimensionless Space&lt;/b&gt;&lt;br&gt;• State of Health (SoH):&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;SoH_k = Q_k / Q_nominal&lt;/b&gt;&lt;br&gt;• Normalized SOC drop ratio&lt;br&gt;• Relative temp rise rate&lt;br&gt;&lt;i&gt;[Resolves Capacity/Voltage Scale]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="392" width="200" height="105" as="geometry" />
        </mxCell>

        <!-- Node 10 -->
        <mxCell id="cell_n10" value="&lt;b&gt;10. Track A: Machine Learning&lt;/b&gt;&lt;br&gt;• StandardScaler (Z-Score)&lt;br&gt;• SVR (RBF Kernel, C=10, ε=0.1)&lt;br&gt;• Random Forest (100 Trees)&lt;br&gt;• Extreme Gradient Boosting (XGB)&lt;br&gt;&lt;i&gt;[High Interpretability / Edge BMS]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="392" width="240" height="105" as="geometry" />
        </mxCell>

        <!-- Node 11 -->
        <mxCell id="cell_n11" value="&lt;b&gt;11. Track B: Deep Transfer Learning&lt;/b&gt;&lt;br&gt;• 1D-CNN: Voltage dynamics&lt;br&gt;• BiLSTM: Sequence memory&lt;br&gt;• Pre-train (NASA) ➔ Tune (CALCE)&lt;br&gt;• Capacity Regeneration mitigation&lt;br&gt;&lt;i&gt;[Few-Shot Adaptation Engine]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeee6;strokeColor=#e67e22;strokeWidth=1.4;fontSize=9.5;fontColor=#d35400;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="565" y="392" width="260" height="105" as="geometry" />
        </mxCell>

        <!-- Node 12 -->
        <mxCell id="cell_n12" value="&lt;i&gt;&lt;b&gt;12. Trained Model Weights&lt;/b&gt;&lt;br&gt;• SVR &amp;amp; XGBoost pipelines&lt;br&gt;• PyTorch CNN-BiLSTM checkpoints&lt;br&gt;• Transferred calibration weights&lt;br&gt;[Generalised Forecasting Artefacts]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;strokeWidth=1.4;fontSize=9.5;fontColor=#145a32;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="392" width="275" height="105" as="geometry" />
        </mxCell>

